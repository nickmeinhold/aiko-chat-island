.venv/
__pycache__/
*.pyc
.env
# the box-local image pin (claude-tasks#5165): the operator's, never the repo's
image.env
spike/work/
spike/logs/
spike/devwork/
spike/devlogs/
*.db
*.sqlite3
.pytest_cache/
.ruff_cache/
backups/

# single-worker guard lock (worker_guard.py) — regenerable, never committed
.aiko-worker.lock
.*.initialized
.*.initialized.tmp

# Bundled LiveKit: rendered config carries the API secret (deploy/livekit/render-config.sh)
deploy/livekit/livekit.yaml
deploy/livekit/.env

# `island standup` writes .env / image.env via <name>.standup-* temporaries; one
# stranded by a SIGKILL can hold the JWT secret, so it must never be committable.
*.standup-*
# `island configure` proves its edit in .env.configure-* before renaming it over .env;
# one stranded by a SIGKILL holds EVERY secret in .env (signing seed, APNs key).
*.configure-*
