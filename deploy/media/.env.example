# deploy/media BOOTSTRAP — per-box values. Copy to .env on the box; NEVER commit .env.
# Real values for enspyr live only on the box.

# Public FQDN of the TURN endpoint (needs an A-record -> this box, port 80
# reachable for Caddy's HTTP-01 challenge).
TURN_DOMAIN=turn.enspyr.co

# Box public IP (LiveKit rtc.node_ip / use_external_ip).
NODE_IP=x.x.x.x

# Per-island LiveKit API key/secret (mint fresh per box — do NOT reuse another
# box's; task #2732). Generate: `livekit-server generate-keys` or any random pair.
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=change-me-per-box-secret

# WSS signaling URL clients join (Caddy-terminated, :443). Gate A's livekit-rtc
# relay client connects here to mint a session-bound TURN cred and force relay.
LIVEKIT_URL=wss://livekit.enspyr.co

# Caddy's LEAF cert dir for TURN_DOMAIN — the single-domain dir, NOT the whole
# Caddy data volume. On systemd-Caddy (enspyr): the host path, e.g.
#   /var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/turn.enspyr.co
CADDY_CERT_LEAF_DIR=/var/lib/caddy/.local/share/caddy/certificates/acme-v02.api.letsencrypt.org-directory/turn.enspyr.co

# Served-cert alarm threshold (days). Chosen so a full change window fits before
# expiry (LE certs are 90d, renew at ~30d left -> N well under 30).
ALARM_NOTAFTER_DAYS=14

# Alarm sink — the box's notify proxy (Telegram). Alert POSTs here on stale cert.
# If the POST fails, the alarm drops a durable flag in ALARM_FLAG_DIR the box
# monitor scrapes, so a dead notify path can't silence it.
ALARM_NOTIFY_URL=http://localhost:8090/notify
ALARM_FLAG_DIR=/var/local/media-alarm

# Renewal restart authority. 1 = machine-forced restart (BOOTSTRAP). 0 =
# detector-only: page but NEVER restart (CLIENT+REPAIR installs it this way).
ALARM_RESTART=1

# Firewall relay range — the SINGLE SOURCE. Drives the rendered livekit.yaml, the
# firewall opens, and the exposure probe (standup asserts all three agree).
TURN_RELAY_START=50000
TURN_RELAY_END=60000

# Gate B3 (relay-to-private-IP denied) is now asserted from the LiveKit VERSION:
# v1.12.0+ denies restricted/private peer CIDRs by default. The gate reads the version
# from LIVEKIT_IMAGE if set, else `docker inspect livekit`. Set this to the pinned ref
# on boxes where the gate can't reach the docker socket.
LIVEKIT_IMAGE=
