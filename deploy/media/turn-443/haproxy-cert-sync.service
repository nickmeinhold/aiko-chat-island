# Sync Caddy's renewed turn cert into HAProxy's PEM + graceful reload (fingerprint-gated).
# Paired with haproxy-cert-sync.timer. Oneshot: runs, syncs if changed, exits.
[Unit]
Description=Sync Caddy turn.enspyr.co cert into HAProxy PEM and reload on change
After=network-online.target caddy.service
Wants=caddy.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/haproxy-cert-sync.sh
# Reads caddy's key, writes /etc/haproxy/certs, reloads haproxy — needs root.
User=root
