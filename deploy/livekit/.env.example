# deploy/livekit/.env — per-island values for the bundled SFU.
# Copy to .env and fill in. NOT in git: LIVEKIT_API_SECRET is a real secret.
#
# render-config.sh fails closed if any of these is unset or empty.

# This host's PUBLIC IP. Must agree with what TURN advertises — a mismatch
# silently kills the UDP relay rather than erroring.
LIVEKIT_NODE_IP=

# Public hostname clients are told to reach TURN on (e.g. turn.example.org).
# Needs DNS pointing here and a TLS terminator in front (see the template's
# note on the external_tls shape).
LIVEKIT_TURN_DOMAIN=

# ONE key pair for THIS island. Generate a fresh pair per island and never
# share one across islands (#2732): a shared media secret is a mesh-wide
# forgery domain — any holder can mint a join token for any island's rooms.
#   LIVEKIT_API_KEY_ID:  openssl rand -hex 8 | sed 's/^/API/'
#   LIVEKIT_API_SECRET:  openssl rand -base64 48 | tr -d '\n'
# These two must ALSO be set in the GATEWAY's .env as LIVEKIT_API_KEY /
# LIVEKIT_API_SECRET — the gateway mints tokens the SFU must accept.
LIVEKIT_API_KEY_ID=
LIVEKIT_API_SECRET=

# Optional: override the pinned server version from docker-compose.livekit.yml.
#LIVEKIT_SERVER_VERSION=v1.13.5
